    "/browser/sms.json": {
      "post": {
        "operationId": "browserSms",
        "summary": "Configure the SMS service",
        "tags": [
          "Integration"
        ],
        "description": "Saves the SMS form of the Integration page. The form is rewritten as a whole: a missing parameter resets its setting (an omitted smsrenew switches renewal off). Get the service ID and its capabilities from browser/services first. Parameters the chosen service does not support are ignored. Parameters may also be sent in the query string. Error codes by HTTP status: 400 bad-type (unknown or withdrawn service), no-api (no key left after splitting), bad-param (a request value is an array; the reply also carries param); 402 unpaid.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "smstype",
                  "smsapi"
                ],
                "properties": {
                  "smstype": {
                    "type": "integer",
                    "enum": [
                      17,
                      19,
                      2,
                      18,
                      8,
                      4,
                      1,
                      3,
                      5,
                      7,
                      16,
                      9,
                      10,
                      11,
                      14,
                      15
                    ],
                    "description": "Service ID from browser/services"
                  },
                  "smsapi": {
                    "type": "string",
                    "description": "Service API key. For a service with a username (login: true) pass the key only and the username in smslogin; a combined \"username key\" value is also accepted and split on the first space."
                  },
                  "smslogin": {
                    "type": "string",
                    "description": "Service username (textverified.com); ignored by other services"
                  },
                  "smsmax": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000,
                    "description": "Maximum phone number price, only for services with price: true. Not a number or 0 = the service default (pricedef)."
                  },
                  "smsterm": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 365,
                    "description": "Rental term in days, only for services with a term. With * any value 0-365; with a list it must be one of the listed days. 0 or an off-list value = the default (termdef)."
                  },
                  "smsrenew": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "default": 0,
                    "description": "1 renews the rental automatically, only for services with renew: true; any non-empty value other than 0 counts as 1"
                  }
                }
              }
            },
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "smstype",
                  "smsapi"
                ],
                "properties": {
                  "smstype": {
                    "type": "integer",
                    "enum": [
                      17,
                      19,
                      2,
                      18,
                      8,
                      4,
                      1,
                      3,
                      5,
                      7,
                      16,
                      9,
                      10,
                      11,
                      14,
                      15
                    ],
                    "description": "Service ID from browser/services"
                  },
                  "smsapi": {
                    "type": "string",
                    "description": "Service API key. For a service with a username (login: true) pass the key only and the username in smslogin; a combined \"username key\" value is also accepted and split on the first space."
                  },
                  "smslogin": {
                    "type": "string",
                    "description": "Service username (textverified.com); ignored by other services"
                  },
                  "smsmax": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000,
                    "description": "Maximum phone number price, only for services with price: true. Not a number or 0 = the service default (pricedef)."
                  },
                  "smsterm": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 365,
                    "description": "Rental term in days, only for services with a term. With * any value 0-365; with a list it must be one of the listed days. 0 or an off-list value = the default (termdef)."
                  },
                  "smsrenew": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "default": 0,
                    "description": "1 renews the rental automatically, only for services with renew: true"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SMS settings saved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
