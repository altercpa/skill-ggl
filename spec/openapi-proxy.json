    "/proxy/load.json": {
      "post": {
        "operationId": "proxyLoad",
        "summary": "Bulk add proxies from a list",
        "tags": [
          "Proxies"
        ],
        "description": "One proxy per line; the format of each line is detected automatically. Accepted: protocol://user:pass@host:port, protocol://host:port:user:pass, user:pass@host:port, host:port:user:pass, host:port, protocol://host:port. Protocols: http, https, socks5, socks5h (socks is an alias for socks5); a line without a protocol, or with an unknown one, is HTTP. Slots and the IP reset link follow the proxy after two pipes: proxy||max or proxy||max||resetlink. A proxy that is already registered is a duplicate: it is skipped and not updated, and a line that cannot be saved at all counts as a duplicate too. Every call recounts count and avail of every proxy in your pool. The reset link of a line follows the same rules as the url parameter of proxy/add: only http:// and https:// links to a public address are kept. The call succeeds even if every line was a duplicate or rejected: read the counters. Error codes by HTTP status: 400 no-list, bad-param (a request value is an array; the reply also carries param); 402 unpaid.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "proxy"
                ],
                "properties": {
                  "proxy": {
                    "type": "string",
                    "description": "The list, one proxy per line (\\n or \\r\\n).",
                    "examples": [
                      "socks5://user:pass@203.0.113.7:1080||25||https://rotate.example.net/abc\n203.0.113.8:1080:login:secret\nhttp://login:secret@203.0.113.9:8080\nhttps://203.0.113.10:8443"
                    ]
                  }
                }
              }
            },
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "proxy"
                ],
                "properties": {
                  "proxy": {
                    "type": "string",
                    "description": "The list, one proxy per line (\\n or \\r\\n).",
                    "examples": [
                      "socks5://user:pass@203.0.113.7:1080||25||https://rotate.example.net/abc\n203.0.113.8:1080:login:secret\nhttp://login:secret@203.0.113.9:8080\nhttps://203.0.113.10:8443"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Load result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProxyLoadResponse"
                },
                "example": {
                  "status": "ok",
                  "added": 3,
                  "duplicates": 1,
                  "rejected": 0,
                  "data": [
                    502,
                    503,
                    504
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/proxy/edit.json": {
      "post": {
        "operationId": "proxyEdit",
        "summary": "Change a proxy",
        "tags": [
          "Proxies"
        ],
        "description": "Changes the settings of one proxy, like the edit form. Send every field, including the unchanged ones: a missing field is cleared (login, password, reset link), type falls back to 0 (HTTP) and max to 1. When the host, port, login, password or type changes, the new settings are pushed to the antidetect browser profiles that use the proxy. Editing does not re-check the proxy and does not change its status: run proxy/check afterwards. Error codes by HTTP status: 400 no-host, no-port, bad-param (a request value is an array; the reply also carries param), edit; 402 unpaid; 404 no-id, bad-id.",
        "parameters": [
          {
            "name": "proxy",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Proxy ID in GGL. May also be sent as a form or JSON field.",
            "required": true
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "host",
                  "port"
                ],
                "properties": {
                  "host": {
                    "type": "string",
                    "description": "IP address or domain"
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535,
                    "description": "Port, 1-65535"
                  },
                  "type": {
                    "$ref": "#/components/schemas/ProxyType",
                    "default": 0,
                    "description": "Stored as sent, without the SOCKS5/SOCKS5H conversion of add. An unknown value, or a name, is replaced with HTTP (0)."
                  },
                  "user": {
                    "type": "string",
                    "description": "Login"
                  },
                  "pass": {
                    "type": "string",
                    "description": "Password"
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 1,
                    "description": "Slots; free slots are recalculated from it"
                  },
                  "url": {
                    "type": "string",
                    "description": "IP reset link. Only http:// and https:// links are kept. A link to an IPv6 address or to a non-public IPv4 address (local, private, link-local including the cloud metadata address, CGNAT) is saved as empty and the proxy is still saved, with no error. A host name is saved but is not called if it resolves to such an address; every redirect is checked the same way, three at most. The service calls the link when it starts work on an account that uses the proxy."
                  }
                }
              }
            },
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "host",
                  "port"
                ],
                "properties": {
                  "host": {
                    "type": "string",
                    "description": "IP address or domain"
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535,
                    "description": "Port, 1-65535"
                  },
                  "type": {
                    "$ref": "#/components/schemas/ProxyType",
                    "default": 0,
                    "description": "Stored as sent"
                  },
                  "user": {
                    "type": "string",
                    "description": "Login"
                  },
                  "pass": {
                    "type": "string",
                    "description": "Password"
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 1,
                    "description": "Slots; free slots are recalculated from it"
                  },
                  "url": {
                    "type": "string",
                    "description": "IP reset link"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Proxy saved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/proxy/check.json": {
      "post": {
        "operationId": "proxyCheck",
        "summary": "Check proxy health now",
        "tags": [
          "Proxies"
        ],
        "description": "Runs a health check right now, like the Check button. The proxies are checked one by one inside the request and each can take up to ten seconds: set a generous client timeout and send small batches. On success the proxy becomes Working and gets its exit IP and country; on failure it becomes Error and errors goes up by one. At most 25 of your proxies per call. Error codes by HTTP status: 400 no-ids (list missing, empty or none of the IDs is yours), many-ids, bad-param (a parameter other than ids is an array; the reply also carries param); 402 unpaid.",
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Proxy IDs as a comma-separated string (501,502,503). Required; may also be sent as a form or JSON field. IDs that are not yours are ignored. ids is the only parameter that may also be passed as an array (ids[]=501&ids[]=502, or a JSON array in the body).",
            "required": true
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "ids": {
                    "oneOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "integer"
                        }
                      },
                      {
                        "type": "string",
                        "description": "Comma-separated IDs, e.g. 501,502,503"
                      }
                    ],
                    "description": "Proxy IDs, an array or a comma-separated string"
                  }
                }
              }
            },
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ids": {
                    "oneOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "integer"
                        }
                      },
                      {
                        "type": "string",
                        "description": "Comma-separated IDs, e.g. 501,502,503"
                      }
                    ],
                    "description": "Proxy IDs, an array or a comma-separated string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New status of every checked proxy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProxyCheckResponse"
                },
                "example": {
                  "status": "ok",
                  "data": {
                    "501": 1,
                    "502": 2
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
