    "/browser/log.json": {
      "get": {
        "operationId": "browserLog",
        "summary": "Integration journal",
        "tags": [
          "Integration"
        ],
        "description": "The requests GGL sent to your antidetect browser, newest first: address, data sent and browser reply. Nothing is masked: url, post, header and cc can contain your browser API token, the management key, proxy credentials and account credentials. Paging is flat (page, show, total), not a nav block. Error codes by HTTP status: 400 bad-param (a request value is an array; the reply also carries param); 402 unpaid.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "Page number, from 1"
          },
          {
            "name": "show",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            },
            "description": "Records per page, 50 by default, at most 200 (a bigger value is cut to 200)"
          },
          {
            "name": "error",
            "in": "query",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            },
            "description": "0 successful requests only, 1 failed requests only. Present but empty counts as 0."
          },
          {
            "name": "acc",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Account ID in GGL: only the records of this account"
          },
          {
            "name": "func",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Browser function name as shown in the journal (for example start): only those records"
          }
        ],
        "responses": {
          "200": {
            "description": "Journal page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogResponse"
                },
                "example": {
                  "status": "ok",
                  "page": 1,
                  "show": 50,
                  "total": 100500,
                  "data": [
                    {
                      "id": 100500,
                      "time": 1754857600,
                      "error": 0,
                      "acc": 101,
                      "func": "start",
                      "code": 200,
                      "codeok": true,
                      "timer": 0.412,
                      "url": "http://203.0.113.10:58307/status",
                      "get": false,
                      "post": false,
                      "postdata": false,
                      "reply": "{\"code\":0}",
                      "header": "<request headers, may contain your browser API token>",
                      "cc": false
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
